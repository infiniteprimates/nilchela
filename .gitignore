# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Local mise overrides (never commit personal pins)
mise.local.toml

# Lockfiles are intentionally committed if you use reproducibility lockdown
# (see mise.example.toml Sec. 4). Do NOT blanket-ignore mise.lock.

# Build/env
.env
.env.*

# Helm: vendored dependency archives/dirs are produced by `helm dependency build`,
# never committed. (`Chart.lock` is deliberately NOT ignored here — locking the
# dependency graph is a separate policy decision for the maintainers.)
**/charts/*.tgz
**/charts/*/
