# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Local mise overrides (never commit personal pins)
mise.local.toml

# Lockfiles are intentionally committed if you use reproducibility lockdown
# (see mise.example.toml Sec. 4). Do NOT blanket-ignore mise.lock.

# Build/env
.env
.env.*

# uv puts the harness venv inside the tree (charts/nilchela/tests/.venv). No
# leading slash, so the pattern matches at any depth.
.venv/

# Byte-compiled cache. CI runs the harness as a script, which leaves none — but
# anything that *imports* it (a local runner, a future pytest collection) leaves
# one beside the source, and it must never be committed.
__pycache__/

# Helm chart dependency output. `helm dependency build` resolves the bjw-s
# `common` library into charts/<chart>/charts/; that archive is reproducible from
# the pinned version in Chart.yaml, so it is not committed.
#
# The glob is deliberate. `charts/` at the repo root is chart *source* and stays
# tracked, so it cannot be ignored by name; what is ignored is the dependency
# directory inside any chart, which survives the chart being renamed or a second
# chart being added. (To vendor a chart there on purpose, add it with `git add -f`.)
charts/*/charts/
