# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Local mise overrides (never commit personal pins)
mise.local.toml

# Lockfiles are intentionally committed if you use reproducibility lockdown
# (see mise.example.toml Sec. 4). Do NOT blanket-ignore mise.lock.

# Build/env
.env
.env.*

# Helm chart dependency output. `helm dependency build` resolves app-template
# (and its common library) into charts/nilchela/charts/; those archives are
# reproducible from the pinned version in Chart.yaml, so they are not committed.
charts/nilchela/charts/
