# The licence texts are compared byte-for-byte by the chart contract test
# (charts/nilchela/tests/chart_contract.py): the chart copies against the root
# originals, and the packaged members against the root originals. `text eol=lf`
# keeps those comparisons stable, and keeps the text inside a published chart
# from depending on the platform of whoever packaged it.
#
# Unanchored patterns match at every directory level, so these three lines cover
# both the root copies and charts/nilchela/.
LICENSE-MIT text eol=lf
LICENSE-APACHE text eol=lf
NOTICE text eol=lf
