+
+  chart-install:
+    name: Chart install (kind)
+    # Everything above inspects the *render*; this is the only layer that runs the
+    # chart. It uses the same fixture the contract test renders, so the two layers
+    # cannot drift: one definition, two consumers.
+    runs-on: ubuntu-26.04
+    timeout-minutes: 15
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+
+      - name: Set up Helm
+        uses: azure/setup-helm@v5
+        with:
+          version: ${{ env.HELM_VERSION }}
+
+      - name: Add the bjw-s chart repository
+        run: >
+          helm repo add --force-update bjw-s
+          https://bjw-s-labs.github.io/helm-charts
+
+      - name: Resolve chart dependencies
+        run: helm dependency build charts/nilchela
+
+      - name: Create cluster
+        uses: helm/kind-action@v1.15.1
+        with:
+          cluster_name: nilchela
+
+      - name: Install the fixture
+        # The namespace and the Secret exist first: the fixture projects
+        # `fresh-install-dummy`, and a projected volume whose source is missing
+        # keeps the pod in ContainerCreating rather than failing visibly.
+        # --wait is the readiness assertion -- the release is not installed until
+        # the pod is Ready, and the pod is only Ready if the daemon boots.
+        run: |
+          set -euo pipefail
+          kubectl create namespace nilchela
+          kubectl --namespace nilchela create secret generic fresh-install-dummy \
+            --from-literal=token=unused
+          helm install nilchela charts/nilchela \
+            --namespace nilchela \
+            --values charts/nilchela/tests/fresh-install-values.yaml \
+            --wait --timeout 8m
+
+      - name: The agent can write its workspace
+        # The check that found the bug by hand. `kubectl exec` runs as the
+        # container's own uid (65534), which is the whole point: root can always
+        # write, so an exec as root would pass on the broken chart too. The
+        # credential mount is nested inside the data volume, and the kubelet
+        # creates that intermediate chain root:root unless prepare-mounts runs.
+        run: |
+          set -euo pipefail
+          pod=$(kubectl --namespace nilchela get pod \
+            -l app.kubernetes.io/controller=main \
+            -o jsonpath='{.items[0].metadata.name}')
+          kubectl --namespace nilchela exec "${pod}" --container main -- sh -euc '
+            w=/zeroclaw-data/.zeroclaw/agents/freshtest/workspace
+            test -r "$w/secrets/gh/token"
+            echo written > "$w/probe"
+            test "$(cat "$w/probe")" = written
+            echo "workspace writable by uid $(id -u)"
+          '
+
+      - name: Diagnostics
+        # A failed exec leaves nothing behind to read, and the pod's own logs are
+        # the only place a boot failure explains itself.
+        if: failure()
+        run: |
+          kubectl --namespace nilchela get pods -o wide
+          kubectl --namespace nilchela describe pods
+          kubectl --namespace nilchela logs --all-containers --prefix --tail=200 \
+            -l app.kubernetes.io/controller=main
